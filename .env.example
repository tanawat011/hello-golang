# Settings for `go run ./sendmail`. Copy to .env and fill in your own;
# .env is git-ignored. Placeholders only — never commit real values.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=change-me
MAIL_FROM=you@example.com
MAIL_TO=friend@example.com
# Optional
MAIL_CC=someone@example.com
MAIL_CC_NAME=Someone
